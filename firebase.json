{
  "functions": [
    {
      "source": "functions",
      "codebase": "oauth-mediator",
      "runtime": "nodejs24",
      "ignore": ["node_modules", ".git", "test", "coverage", "*.log"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run lint", "npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "hosting": {
    "site": "nubecita-2a4c1",
    "public": "hosting",
    "ignore": ["**/.*"],
    "rewrites": [
      {
        "source": "**",
        "function": {
          "functionId": "oauthMediator",
          "region": "us-central1"
        }
      }
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
